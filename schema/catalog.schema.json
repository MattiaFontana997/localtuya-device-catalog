{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MattiaFontana997/localtuya-device-catalog/schema/catalog.schema.json",
  "title": "LocalTuya Device Catalog",
  "type": "object",
  "required": [
    "schema_version",
    "mappings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "mappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mapping"
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_dps",
        "required_dps",
        "protocol_version",
        "entity_count"
      ],
      "properties": {
        "observed_dps": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "required_dps": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "protocol_version": {
          "type": "string"
        },
        "entity_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$defs": {
    "mapping": {
      "type": "object",
      "required": [
        "id",
        "confidence",
        "match",
        "entities"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "experimental",
            "verified",
            "community"
          ]
        },
        "match": {
          "type": "object",
          "required": [
            "product_id",
            "category",
            "required_dps"
          ],
          "additionalProperties": false,
          "properties": {
            "product_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "category": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "required_dps": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        },
        "entities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/entity"
          }
        }
      }
    },
    "entity": {
      "type": "object",
      "required": [
        "platform",
        "config"
      ],
      "additionalProperties": false,
      "properties": {
        "platform": {
          "type": "string",
          "enum": [
            "binary_sensor",
            "climate",
            "cover",
            "fan",
            "light",
            "number",
            "select",
            "sensor",
            "switch",
            "vacuum"
          ]
        },
        "config": {
          "type": "object",
          "required": [
            "id",
            "platform"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "platform": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MattiaFontana997/localtuya-device-catalog/schema/catalog.schema.json",
  "title": "LocalTuya Device Catalog",
  "type": "object",
  "required": [
    "schema_version",
    "mappings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        2,
        3
      ]
    },
    "mappings": {
      "type": "array"
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_dps",
        "required_dps",
        "optional_dps",
        "protocol_version",
        "entity_count"
      ],
      "properties": {
        "observed_dps": {
          "$ref": "#/$defs/dp_array"
        },
        "required_dps": {
          "$ref": "#/$defs/dp_array"
        },
        "optional_dps": {
          "$ref": "#/$defs/dp_array"
        },
        "protocol_version": {
          "type": "string"
        },
        "entity_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$defs": {
    "dp_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      }
    },
    "match_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "const": "exact_dps"
        }
      }
    },
    "mapping": {
      "type": "object",
      "required": [
        "id",
        "confidence",
        "match",
        "entities"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "experimental",
            "verified",
            "community"
          ]
        },
        "match": {
          "type": "object",
          "required": [
            "product_ids",
            "category",
            "required_dps",
            "optional_dps"
          ],
          "additionalProperties": false,
          "properties": {
            "product_ids": {
              "type": "array",
              "minItems": 0,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "category": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "required_dps": {
              "$ref": "#/$defs/dp_array"
            },
            "optional_dps": {
              "$ref": "#/$defs/dp_array"
            },
            "fingerprint": {
              "$ref": "#/$defs/match_fingerprint"
            }
          }
        },
        "entities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "license"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "entity": {
      "type": "object",
      "required": [
        "platform",
        "config"
      ],
      "additionalProperties": false,
      "properties": {
        "platform": {
          "type": "string",
          "enum": [
            "alarm_control_panel",
            "binary_sensor",
            "button",
            "camera",
            "climate",
            "cover",
            "datetime",
            "event",
            "fan",
            "humidifier",
            "infrared",
            "lawn_mower",
            "light",
            "lock",
            "number",
            "remote",
            "select",
            "sensor",
            "siren",
            "switch",
            "text",
            "time",
            "vacuum",
            "valve",
            "water_heater"
          ]
        },
        "config": {
          "type": "object",
          "required": [
            "id",
            "platform"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "platform": {
              "type": "string"
            },
            "sensor_value_mapping": {
              "$ref": "#/$defs/sensor_value_mapping"
            },
            "fan_speed_mapping": {
              "$ref": "#/$defs/fan_speed_mapping"
            },
            "fan_oscillating_mapping": {
              "$ref": "#/$defs/fan_oscillating_mapping"
            },
            "fan_preset_raw_type": {
              "enum": [
                "string",
                "integer",
                "boolean"
              ]
            }
          }
        },
        "override_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_]+$"
          }
        }
      }
    },
    "product_mapping": {
      "allOf": [
        {
          "$ref": "#/$defs/mapping"
        },
        {
          "properties": {
            "match": {
              "properties": {
                "product_ids": {
                  "minItems": 1
                }
              },
              "not": {
                "required": [
                  "fingerprint"
                ]
              }
            }
          }
        }
      ]
    },
    "fingerprint_mapping": {
      "allOf": [
        {
          "$ref": "#/$defs/mapping"
        },
        {
          "properties": {
            "confidence": {
              "not": {
                "const": "verified"
              }
            },
            "match": {
              "required": [
                "fingerprint"
              ],
              "properties": {
                "product_ids": {
                  "maxItems": 0
                },
                "fingerprint": {
                  "const": {
                    "mode": "exact_dps"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "sensor_value_mapping": {
      "type": "object",
      "required": [
        "raw_type",
        "rules"
      ],
      "additionalProperties": false,
      "properties": {
        "raw_type": {
          "enum": [
            "string",
            "integer",
            "float",
            "boolean"
          ]
        },
        "range": {
          "type": "object",
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "dps_val": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "invert": {
                "type": "boolean"
              },
              "target_range": {
                "type": "object",
                "required": [
                  "min",
                  "max"
                ],
                "additionalProperties": false,
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  }
                }
              },
              "icon": {
                "type": "string",
                "pattern": "^mdi:"
              }
            }
          }
        }
      }
    },
    "fan_speed_mapping": {
      "type": "object",
      "required": [
        "raw_type",
        "rules"
      ],
      "additionalProperties": false,
      "properties": {
        "raw_type": {
          "enum": [
            "string",
            "integer"
          ]
        },
        "rules": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "dps_val",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "dps_val": {
                "type": [
                  "string",
                  "integer"
                ]
              },
              "value": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    "fan_oscillating_mapping": {
      "type": "object",
      "required": [
        "raw_type",
        "rules"
      ],
      "additionalProperties": false,
      "properties": {
        "raw_type": {
          "enum": [
            "string",
            "integer",
            "boolean"
          ]
        },
        "rules": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "dps_val": {
                "type": [
                  "string",
                  "integer",
                  "boolean"
                ]
              },
              "value": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "mappings": {
            "items": {
              "$ref": "#/$defs/product_mapping"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 3
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "mappings": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/$defs/product_mapping"
                },
                {
                  "$ref": "#/$defs/fingerprint_mapping"
                }
              ]
            }
          }
        }
      }
    }
  ]
}
